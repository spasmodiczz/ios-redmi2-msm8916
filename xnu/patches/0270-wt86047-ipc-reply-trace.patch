diff --git a/osfmk/ipc/ipc_mqueue.c b/osfmk/ipc/ipc_mqueue.c
index c6a8565..d9641dd 100755
--- a/osfmk/ipc/ipc_mqueue.c
+++ b/osfmk/ipc/ipc_mqueue.c
@@ -605,6 +605,37 @@ ipc_mqueue_post(
 	struct waitq *waitq = &port->ip_waitq;
 	boolean_t destroy_msg = FALSE;
 
+	/*
+	 * SWEET IPC reply trace.
+	 *
+	 * SpringBoard blocks in a synchronous XPC to lsd (_LSCopyServerStore ->
+	 * _LSContextInitCommon -> send_message_with_reply_sync) and never wakes.
+	 * Either the request never reached lsd, or lsd replied and the waiter was
+	 * not woken; sampling cannot tell those apart because both sides sit in
+	 * mach_msg. Replies carry a send-once right as their remote disposition,
+	 * so log exactly those, with both pids and the msgh_id, and compare the
+	 * pids against the sampler's "SMP <name>[pid]" headers afterwards.
+	 */
+	{
+		static int sweet_ipc_logs;
+		mach_msg_type_name_t remote =
+		    MACH_MSGH_BITS_REMOTE(kmsg->ikm_header->msgh_bits);
+
+		if (sweet_ipc_logs < 2500 &&
+		    (remote == MACH_MSG_TYPE_MOVE_SEND_ONCE ||
+		    remote == MACH_MSG_TYPE_MAKE_SEND_ONCE)) {
+			task_t rt = ip_get_receiver(port);
+			int spid = task_pid(current_task());
+			int rpid = rt ? task_pid(rt) : -1;
+
+			if (spid > 1 || rpid > 1) {
+				sweet_ipc_logs++;
+				printf("SWEET IPC R %d -> %d id %d n %d\n",
+				    spid, rpid, kmsg->ikm_header->msgh_id, sweet_ipc_logs);
+			}
+		}
+	}
+
 	ipc_kmsg_trace_send(kmsg, option);
 
 	/*
