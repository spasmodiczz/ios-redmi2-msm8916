diff --git a/osfmk/kern/socd_client.c b/osfmk/kern/socd_client.c
--- a/osfmk/kern/socd_client.c
+++ b/osfmk/kern/socd_client.c
@@ -99,6 +99,30 @@
 	socd_client_trace_arg_t  arg3,
 	socd_client_trace_arg_t  arg4)
 {
+#if defined(WT86047)
+	/*
+	 * Every tracepoint ends in debug_is_current_cpu_in_panic_state(), which
+	 * reads per-CPU data via current_percpu_base() -> current_thread(). During
+	 * early boot TPIDR_EL1 holds no thread, so that dereferences NULL at
+	 * offset 0x220 and faults inside the fault handler, which the watchdog
+	 * turns into a reset. Backtrace read off the panel:
+	 *   socd_client_trace -> debug_is_current_cpu_in_panic_state
+	 *     -> current_percpu_base (pc), far = 0x220.
+	 *
+	 * There is nothing worth tracing before the first thread exists, and both
+	 * the buffer path and the KDBG duplicate need per-CPU state, so drop the
+	 * call. Read TPIDR_EL1 directly: this file does not pull in the headers
+	 * that define current_thread(), and it must not gain a dependency here.
+	 */
+	{
+		unsigned long tpidr_el1;
+
+		__asm__("mrs %0, TPIDR_EL1" : "=r"(tpidr_el1));
+		if (tpidr_el1 == 0) {
+			return;
+		}
+	}
+#endif
 	socd_client_trace_entry_t entry;
 	uint32_t trace_idx, buff_idx, len;
 	uint64_t time_ns;
