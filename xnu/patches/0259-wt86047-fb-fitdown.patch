 static uint32_t sweet_fb_swaps_logged;
 
+/*
+ * SWEET FB FIT: show the whole canvas on a smaller panel.
+ *
+ * 0168's copy path is 1:1 on purpose: iOS composites at the canvas size and
+ * the kernel crops it to the panel with fOffX/fOffY, so nothing is ever
+ * scaled. That is correct and cheap, but on this board the panel window is
+ * 720x320 while the canvas is 1125x2436, so the crop shows about a sixteenth
+ * of the screen.
+ *
+ *	sweetfb_fit=1	stretch the whole layer surface over the panel
+ *	sweetfb_fit=2	keep the aspect ratio and letterbox
+ *
+ * Nearest neighbour on purpose: the panel is a debug window here, and a
+ * box filter would cost 4x the reads for a picture that is already distorted.
+ * The 1:1 path is untouched when the argument is absent.
+ */
+#define SWEET_FB_FIT_MAX_W 1024
+
+static uint32_t
+sweet_fb_fit_mode(void)
+{
+	static int cached = -1;
+	int v = 0;
+
+	if (cached < 0) {
+		cached = (PE_parse_boot_argn("sweetfb_fit", &v, sizeof(v)) && v > 0) ? v : 0;
+	}
+	return (uint32_t)cached;
+}
+
+static void
+sweet_fb_scale_into(uint8_t *dst, uint32_t dstStride, uint32_t dstX, uint32_t dstY,
+    uint32_t outW, uint32_t outH, const uint8_t *src, uint32_t srcStride,
+    uint32_t srcW, uint32_t srcH)
+{
+	uint16_t xmap[SWEET_FB_FIT_MAX_W];
+	uint32_t x, y;
+
+	if (outW == 0 || outH == 0 || srcW == 0 || srcH == 0) {
+		return;
+	}
+	if (outW <= SWEET_FB_FIT_MAX_W) {
+		for (x = 0; x < outW; x++) {
+			xmap[x] = (uint16_t)(((uint64_t)x * srcW) / outW);
+		}
+	}
+	for (y = 0; y < outH; y++) {
+		const uint8_t *srow = src + (uint64_t)(((uint64_t)y * srcH) / outH) * srcStride;
+		uint8_t *drow = dst + (uint64_t)(dstY + y) * dstStride + (uint64_t)dstX * 4;
+
+		if (outW <= SWEET_FB_FIT_MAX_W) {
+			for (x = 0; x < outW; x++) {
+				memcpy(drow + (uint64_t)x * 4, srow + (uint64_t)xmap[x] * 4, 4);
+			}
+		} else {
+			for (x = 0; x < outW; x++) {
+				uint32_t sx = (uint32_t)(((uint64_t)x * srcW) / outW);
+
+				memcpy(drow + (uint64_t)x * 4, srow + (uint64_t)sx * 4, 4);
+			}
+		}
+	}
+}
+
+
 /*
  * SWEET FBSURF: is anything drawn at all?
