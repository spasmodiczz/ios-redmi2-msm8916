 		if (src != 0 && bpe == 4) {
-			for (int32_t y = 0; y < h; y++) {
-				memcpy((void *)(dst + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
-				    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
-				    (size_t)w * 4);
+			uint32_t fit = sweet_fb_fit_mode();
+
+			if (fit != 0) {
+				/*
+				 * Ignore the cropped rect: the point is the whole
+				 * surface, fitted onto the panel.
+				 */
+				uint32_t outW = fWidth, outH = fHeight;
+				uint32_t outX = 0, outY = 0;
+
+				if (fit == 2) {
+					uint64_t byW = ((uint64_t)fWidth << 16) / s->width;
+					uint64_t byH = ((uint64_t)fHeight << 16) / s->height;
+					uint64_t k = byW < byH ? byW : byH;
+
+					outW = (uint32_t)(((uint64_t)s->width * k) >> 16);
+					outH = (uint32_t)(((uint64_t)s->height * k) >> 16);
+					if (outW == 0 || outH == 0) {
+						outW = outH = 1;
+					}
+					outX = (fWidth - outW) / 2;
+					outY = (fHeight - outH) / 2;
+				}
+				sweet_fb_scale_into(dst, fRowBytes, outX, outY, outW, outH,
+				    (const uint8_t *)(src + s->offset), s->bytesPerRow,
+				    (uint32_t)s->width, (uint32_t)s->height);
+			} else {
+				for (int32_t y = 0; y < h; y++) {
+					memcpy((void *)(dst + (uint64_t)(dy + y) * fRowBytes + (uint64_t)dx * 4),
+					    (const void *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)sx * 4),
+					    (size_t)w * 4);
+				}
 			}
 		}
 		s->release();
