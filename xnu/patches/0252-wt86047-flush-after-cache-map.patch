--- a/bsd/vm/vm_unix.c
+++ b/bsd/vm/vm_unix.c
@@ -2720,6 +2720,23 @@
 
 	/* map the file(s) into that shared region's submap */
 	kr = vm_shared_region_map_file(shared_region, files_count, sr_file_mappings);
+#if defined(ARM64_BOARD_CONFIG_WT86047)
+	/*
+	 * SWEET: the dyld shared cache is mapped read-execute from a file whose
+	 * pages this kernel also hands out for other data. If a physical page was
+	 * executed earlier and the instruction cache still holds that occupant's
+	 * bytes, the CPU fetches them instead of the code stored at this cache
+	 * offset -- observed as an ASCII string ("@H(N") where the file holds a
+	 * real instruction. Flush once per mapping: cheap, and unambiguous.
+	 */
+	if (kr == KERN_SUCCESS) {
+		extern void FlushPoC_Dcache(void);
+		extern void InvalidatePoU_Icache(void);
+
+		FlushPoC_Dcache();
+		InvalidatePoU_Icache();
+	}
+#endif /* ARM64_BOARD_CONFIG_WT86047 */
 	if (kr != KERN_SUCCESS) {
 		SHARED_REGION_TRACE_ERROR(("shared_region: %p [%d(%s)] map(): "
 		    "vm_shared_region_map_file() failed kr=0x%x\n",
