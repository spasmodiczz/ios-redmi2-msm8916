 #include <stdint.h>
 #include <kern/misc_protos.h>
 
+#if defined(WT86047)
+static volatile uint8_t *early_fb = (volatile uint8_t *)(uintptr_t)0x831FA400;
+#define EARLY_FB early_fb
+#define EARLY_W 720u
+#define EARLY_H 320u
+#define EARLY_STRIDE 2160u
+#define EARLY_SCALE 1u
+#define EARLY_CELL_W (8u * EARLY_SCALE)
+#define EARLY_CELL_H (16u * EARLY_SCALE)
+#define EARLY_ROWS ((EARLY_H - 32u) / EARLY_CELL_H) /* keep the mark band */
+/*
+ * Measured on the panel: post-TTBR0 output rendered 8 cells right of the
+ * pre-TTBR0 output, so a 90-column row overshot the 720 px row by the same
+ * amount. The base bias above removes the shift; 88 columns (704 px) leaves a
+ * small safety margin at the right edge instead of relying on an exact fit.
+ */
+/*
+ * Measured on the panel: post-TTBR0 output lands 74 px (9 cells, 222 bytes)
+ * to the right of where the pre-TTBR0 output lands, and the stage-mark band
+ * and the text are both displaced by the same amount. Pull the post-TTBR0
+ * base back by that bias so the text starts at column 0. If the log ever
+ * loses its first ~9 characters instead, this value is too large.
+ */
+#define WT86047_FB_X_BIAS 192u /* exactly 8 cells: 64 px, 192 bytes */
+#define EARLY_COLS 88u
+
+static inline void early_pixel24(unsigned int x, unsigned int y, uint32_t c) {
+	if (x >= EARLY_W || y >= EARLY_H) return;
+	volatile uint8_t *p = EARLY_FB + (y * EARLY_STRIDE) + (x * 3);
+	p[0] = (uint8_t)(c & 0xff);        // Blue
+	p[1] = (uint8_t)((c >> 8) & 0xff); // Green
+	p[2] = (uint8_t)((c >> 16) & 0xff);// Red
+}
+#else
 static volatile uint32_t *early_fb = (volatile uint32_t *)(uintptr_t)0x9c000000;
 #define EARLY_FB early_fb
 #define EARLY_WIDTH 1080u
@@ -21,6 +41,7 @@
 #define EARLY_CELL_H (16u * EARLY_SCALE)
 #define EARLY_ROWS ((EARLY_HEIGHT - 32u) / EARLY_CELL_H)
 #define EARLY_COLS (EARLY_WIDTH / EARLY_CELL_W)
+#endif
 
 extern unsigned char iso_font[256 * 16];
 
@@ -31,12 +52,39 @@
 static void
 sweet_early_clear_row(void)
 {
+#if defined(WT86047)
+	/*
+	 * sweet_early_putc advances early_row modulo EARLY_ROWS, so without this
+	 * the newest line lands on row 0 while the oldest lines stay at the
+	 * bottom: the window ends up holding two disconnected chunks of the log
+	 * and reads as garbled text. Shift the window up one cell on wrap so the
+	 * log always runs top-to-bottom in order, newest at the bottom.
+	 */
+	static unsigned int prev_row = ~0u;
+	if (prev_row != ~0u && early_row <= prev_row) {
+		for (unsigned int y = 0; y < (EARLY_ROWS - 1) * EARLY_CELL_H; y++) {
+			volatile uint8_t *dst = EARLY_FB + y * EARLY_STRIDE;
+			volatile uint8_t *src = dst + EARLY_CELL_H * EARLY_STRIDE;
+			for (unsigned int x = 0; x < EARLY_W * 3; x++) {
+				dst[x] = src[x];
+			}
+		}
+		early_row = EARLY_ROWS - 1;
+	}
+	prev_row = early_row;
+	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
+		for (unsigned int x = 0; x < EARLY_W; x++) {
+			early_pixel24(x, early_row * EARLY_CELL_H + y, 0x00000000u);
+		}
+	}
+#else
 	for (unsigned int y = 0; y < EARLY_CELL_H; y++) {
 		volatile uint32_t *line = EARLY_FB + (early_row * EARLY_CELL_H + y) * EARLY_STRIDE;
 		for (unsigned int x = 0; x < EARLY_WIDTH; x++) {
 			line[x] = 0xff000000u;
 		}
 	}
+#endif
 }
 
 void
@@ -64,6 +93,15 @@
 	const unsigned char *glyph = iso_font + (unsigned char)c * 16;
 	for (unsigned int gy = 0; gy < 16; gy++) {
 		for (unsigned int sy = 0; sy < EARLY_SCALE; sy++) {
+#if defined(WT86047)
+			unsigned int py = early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy] & (1u << gx)) ? 0x00ffffffu : 0x00000000u;
+				for (unsigned int sx = 0; sx < EARLY_SCALE; sx++) {
+					early_pixel24(early_col * EARLY_CELL_W + gx * EARLY_SCALE + sx, py, pixel);
+				}
+			}
+#else
 			volatile uint32_t *line = EARLY_FB +
 			    (early_row * EARLY_CELL_H + gy * EARLY_SCALE + sy) * EARLY_STRIDE +
 			    early_col * EARLY_CELL_W;
@@ -73,6 +111,7 @@
 					line[gx * EARLY_SCALE + sx] = pixel;
 				}
 			}
+#endif
 		}
 	}
 	early_col++;
@@ -93,11 +132,27 @@
 		return;
 	}
 	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+#if defined(WT86047)
+	for (unsigned int y = (EARLY_H > 32 ? EARLY_H - 32 : 0); y < EARLY_H; y++) {
+		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+			early_pixel24(x, y, color);
+		}
+	}
+	/* Reference ticks at buffer x = 0 and x = 719, redrawn last so they survive:
+	 * they make the console origin measurable straight off a photo. */
+	for (unsigned int y = (EARLY_H > 32 ? EARLY_H - 32 : 0); y < EARLY_H; y++) {
+		early_pixel24(0, y, 0x00ffffffu);
+		early_pixel24(1, y, 0x00ffffffu);
+		early_pixel24(EARLY_W - 2, y, 0x00ffffffu);
+		early_pixel24(EARLY_W - 1, y, 0x00ffffffu);
+	}
+#else
 	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
 		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
 			EARLY_FB[y * EARLY_STRIDE + x] = color;
 		}
 	}
+#endif
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_string("SWEET EARLY ");
 	if (stage >= 10) {
@@ -129,7 +176,64 @@
 sweet_early_relocate(uint64_t base)
 {
 	sweet_early_mark(8, "leaving bootstrap TTBR0");
+#if defined(WT86047)
+	/*
+	 * The alias is a 2 MB L2 block, so the block maps from the 2 MB aligned VA
+	 * below `base`. sweet_early_map_final() installs it with the physical base
+	 * 0x83000000 at that block base, which means every access through `base`
+	 * would be shifted by the in-block offset (base & 0x1FFFFF). Anchor on the
+	 * block base first, then add the row-960 offset.
+	 */
+	early_fb = (volatile uint8_t *)(uintptr_t)
+	    ((base & ~(uint64_t)0x1FFFFFULL) + 0x1FA400 - WT86047_FB_X_BIAS);
+#else
 	early_fb = (volatile uint32_t *)(uintptr_t)base;
+#endif
 	__asm__ volatile("dsb sy" ::: "memory");
 	sweet_early_mark(9, "kernel framebuffer VA live");
 }
+#if defined(WT86047)
+/*
+ * Fixed-position text for panic summaries.
+ *
+ * The log window holds 18 rows and a register dump fills 15 of them, so
+ * anything printed as an ordinary line is scrolled off before it can be read.
+ * The bottom 32 px of the buffer is the stage-mark band: the pager never
+ * touches it, so a line written here survives the dump. Four 8 px rows; the
+ * glyph is sampled every other font row to fit.
+ */
+void
+sweet_early_fixed(int line, const char *s)
+{
+	unsigned int y0;
+	unsigned int col;
+
+	if (line < 0 || line > 3) {
+		return;
+	}
+	y0 = (EARLY_H > 32u ? EARLY_H - 32u : 0u) + (unsigned int)line * 8u;
+	for (unsigned int y = 0; y < 8; y++) {
+		for (unsigned int x = 0; x < EARLY_W; x++) {
+			early_pixel24(x, y0 + y, 0x00000000u);
+		}
+	}
+	for (col = 0; s[col] != 0 && col * EARLY_CELL_W < EARLY_W; col++) {
+		const unsigned char *glyph = iso_font + (unsigned char)s[col] * 16;
+		for (unsigned int gy = 0; gy < 8; gy++) {
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t pixel = (glyph[gy * 2] & (1u << gx)) ?
+				    0x00ffffffu : 0x00000000u;
+				early_pixel24(col * EARLY_CELL_W + gx, y0 + gy, pixel);
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+#else
+void
+sweet_early_fixed(int line, const char *s)
+{
+	(void)line;
+	(void)s;
+}
+#endif
