diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 143db60..6836c2a 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -606,7 +606,9 @@ sweet_ufs_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, __unused int flag,
 		if (*f < DEV_BSIZE || *f > UFS_BLOCK || (*f & (*f - 1))) {
 			return EINVAL;
 		}
-		su.secsize = *f;
+		printf("SWEET UFS: DKIOCSETBLOCKSIZE request %u (keeping %u)\n",
+		    (unsigned)*f, (unsigned)UFS_BLOCK);
+		su.secsize = UFS_BLOCK;
 		return 0;
 	case DKIOCGETPHYSICALBLOCKSIZE:
 		*f = UFS_BLOCK;
@@ -772,7 +774,19 @@ sweet_ufs_init(void)
 	}
 	su.dma_pa = ptoa_64(pn);
 	su.lun = 0;
-	su.secsize = DEV_BSIZE;
+	/*
+	 * Report the device's atomic block (4 KiB) rather than 512 bytes.
+	 *
+	 * With 512 the BSD layer hands down 512-byte buffers, so every metadata
+	 * write that does not cover a whole device block has to be read-merged-
+	 * written. HFS updates the allocation bitmap one 512-byte sector at a
+	 * time, which is exactly the pattern that loses an update when the
+	 * read-merge-write reads the device while a neighbouring sector of the
+	 * same 4 KiB block is still dirty in the buffer cache. The result on
+	 * this volume is duplicated block allocations, then
+	 * 'BlockMarkFreeInternal() trying to free unallocated blocks'.
+	 */
+	su.secsize = UFS_BLOCK;
 
 	lck_mtx_lock(&sweet_ufs_lock);
 	error = ufs_take_over_host();
