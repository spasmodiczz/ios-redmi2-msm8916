+/*
+ * Minimal formatters. This file has no printf-family header (the existing
+ * printf() comes in through pexpert.h), so snprintf() is not declared here and
+ * the markers are assembled by hand instead of betting on an implicit
+ * declaration that current clang rejects.
+ */
+static char *
+wt86047_log_dec(char *p, uint64_t v)
+{
+	char tmp[24];
+	int n = 0;
+
+	do {
+		tmp[n++] = (char)('0' + (v % 10));
+		v /= 10;
+	} while (v != 0);
+	while (n > 0) {
+		*p++ = tmp[--n];
+	}
+	return p;
+}
+
+static char *
+wt86047_log_dec3(char *p, uint32_t v)
+{
+	*p++ = (char)('0' + (v / 100) % 10);
+	*p++ = (char)('0' + (v / 10) % 10);
+	*p++ = (char)('0' + v % 10);
+	return p;
+}
+
+static char *
+wt86047_log_hex(char *p, uint64_t v)
+{
+	static const char digits[] = "0123456789abcdef";
+	bool started = false;
+
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		uint32_t d = (uint32_t)((v >> shift) & 0xf);
+
+		if (d != 0) {
+			started = true;
+		}
+		if (started || shift == 0) {
+			*p++ = digits[d];
+		}
+	}
+	return p;
+}
+
+static char *
+wt86047_log_str(char *p, const char *s)
+{
+	while (*s != 0) {
+		*p++ = *s++;
+	}
+	return p;
+}
+
+/* Milliseconds since boot, shared by the header and the in-stream markers. */
+static uint64_t
+wt86047_log_uptime_ms(void)
+{
+	uint64_t ns = 0;
+
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns / NSEC_PER_MSEC;
+}
+
+/* One "[WT86047 t=12.345s]" marker per second, so the dump has a time axis. */
+static void
+wt86047_log_marker(void)
+{
+	uint64_t now = mach_absolute_time();
+	uint64_t since = 0, uptime;
+	char line[48];
+	char *p = line;
+
+	absolutetime_to_nanoseconds(now - wt86047_log_mark, &since);
+	if (wt86047_log_mark != 0 && since < WT86047_LOG_MARK_NS) {
+		return;
+	}
+	wt86047_log_mark = now;
+	uptime = wt86047_log_uptime_ms();
+
+	*p++ = '\n';
+	p = wt86047_log_str(p, "[WT86047 t=");
+	p = wt86047_log_dec(p, uptime / 1000);
+	*p++ = '.';
+	p = wt86047_log_dec3(p, (uint32_t)(uptime % 1000));
+	p = wt86047_log_str(p, "s]\n");
+	wt86047_log_append(line, (int)(p - line));
+}
 
