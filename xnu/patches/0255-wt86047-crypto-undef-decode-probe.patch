+#if defined(ARM64_BOARD_CONFIG_WT86047)
+/*
+ * SWEET (WT86047): the A53 in MSM8916 has no ARMv8 crypto extension, yet the
+ * iOS userland executes aese, aesmc, the sha1/sha256 ops and pmull anyway,
+ * because arm64
+ * libcorecrypto binds those implementations at compile time. This decoder is
+ * the first half of the emulation work: it recognises the instruction word,
+ * counts it, and can step over it so that a single boot enumerates every
+ * opcode the real boot path needs.
+ *
+ *	sweetemu=0  (default) leave the exception alone, SIGILL as before
+ *	sweetemu=1  decode + print, still deliver the SIGILL
+ *	sweetemu=2  decode + print + step over the instruction; crypto results
+ *	            are then WRONG, use it only to enumerate opcodes
+ *	sweetemu=3  decode + print + EMULATE aese/aesd/aesmc/aesimc for real;
+ *	            every other opcode is still stepped over (and reported)
+ *
+ * The tunable name must NOT start with '-' : PE_parse_boot_argn treats any
+ * dash-prefixed argument as a boolean and stores 1, ignoring "=value".
+ */
+enum sweet_crypto_op {
+	SEO_NONE = 0,
+	SEO_AESE, SEO_AESD, SEO_AESMC, SEO_AESIMC,
+	SEO_SHA1C, SEO_SHA1P, SEO_SHA1M, SEO_SHA1H, SEO_SHA1SU0, SEO_SHA1SU1,
+	SEO_SHA256H, SEO_SHA256H2, SEO_SHA256SU0, SEO_SHA256SU1,
+	SEO_PMULL_Q, SEO_PMULL2_Q, SEO_PMULL_H, SEO_PMULL2_H,
+	SEO_COUNT
+};
+
+struct sweet_crypto_encoding {
+	uint32_t    match;
+	uint32_t    mask;
+	uint8_t     op;
+	uint8_t     nreg;
+	const char *name;
+};
+
+/*
+ * Generated with `llvm-mc -triple=arm64-apple-darwin -mattr=+crypto
+ * -show-encoding` and verified against three different register combinations.
+ * The masks leave out only the register fields (Rd [4:0], Rn [9:5],
+ * Rm [20:16]); two-register forms keep Rm fixed.
+ */
+static const struct sweet_crypto_encoding sweet_crypto_encodings[] = {
+	{ 0x4e284800u, 0xfffffc00u, SEO_AESE,      2, "aese"     },
+	{ 0x4e285800u, 0xfffffc00u, SEO_AESD,      2, "aesd"     },
+	{ 0x4e286800u, 0xfffffc00u, SEO_AESMC,     2, "aesmc"    },
+	{ 0x4e287800u, 0xfffffc00u, SEO_AESIMC,    2, "aesimc"   },
+	{ 0x5e000000u, 0xffe0fc00u, SEO_SHA1C,     3, "sha1c"    },
+	{ 0x5e001000u, 0xffe0fc00u, SEO_SHA1P,     3, "sha1p"    },
+	{ 0x5e002000u, 0xffe0fc00u, SEO_SHA1M,     3, "sha1m"    },
+	{ 0x5e280800u, 0xfffffc00u, SEO_SHA1H,     2, "sha1h"    },
+	{ 0x5e003000u, 0xffe0fc00u, SEO_SHA1SU0,   3, "sha1su0"  },
+	{ 0x5e281800u, 0xfffffc00u, SEO_SHA1SU1,   2, "sha1su1"  },
+	{ 0x5e004000u, 0xffe0fc00u, SEO_SHA256H,   3, "sha256h"  },
+	{ 0x5e005000u, 0xffe0fc00u, SEO_SHA256H2,  3, "sha256h2" },
+	{ 0x5e282800u, 0xfffffc00u, SEO_SHA256SU0, 2, "sha256su0"},
+	{ 0x5e006000u, 0xffe0fc00u, SEO_SHA256SU1, 3, "sha256su1"},
+	{ 0x0ee0e000u, 0xffe0fc00u, SEO_PMULL_Q,   3, "pmull.1q" },
+	{ 0x4ee0e000u, 0xffe0fc00u, SEO_PMULL2_Q,  3, "pmull2.1q"},
+	{ 0x0e20e000u, 0xffe0fc00u, SEO_PMULL_H,   3, "pmull.8h" },
+	{ 0x4e20e000u, 0xffe0fc00u, SEO_PMULL2_H,  3, "pmull2.8h"},
+};
+
+#define SWEET_CRYPTO_ENCODING_COUNT \
+	(sizeof(sweet_crypto_encodings) / sizeof(sweet_crypto_encodings[0]))
+
+TUNABLE(uint32_t, sweet_emu_mode, "sweetemu", 0);
+
+static uint32_t sweet_emu_hits[SEO_COUNT];
+static uint8_t  sweet_emu_printed[SEO_COUNT];
+
+static const struct sweet_crypto_encoding *
+sweet_crypto_decode(uint32_t instr)
+{
+	uint32_t i;
+
+	for (i = 0; i < SWEET_CRYPTO_ENCODING_COUNT; i++) {
+		if ((instr & sweet_crypto_encodings[i].mask) ==
+		    sweet_crypto_encodings[i].match) {
+			return &sweet_crypto_encodings[i];
+		}
+	}
+	return NULL;
+}
+
+/*
+ * --- AES round instructions ------------------------------------------------
+ *
+ * aese/aesd/aesmc/aesimc are the only instructions the boot path has needed so
+ * far (boot 10: three aese + three aesmc at image +0x900/+0x904). The state is
+ * column major: vector byte i is state row (i & 3), column (i >> 2), exactly
+ * how the architecture numbers it. Everything below is plain C on a 16-byte
+ * array; the vector state is read from, and written to, the NEON part of the
+ * exception context (see sweet_crypto_emu_probe).
+ */
+
+/*
+ * The vector registers must NOT be touched through the live architectural
+ * state: sleh_synchronous passes only &context->ss, the kernel saved the NEON
+ * registers into context->ns on exception entry and restores them on the way
+ * out, so anything written to q0..q31 directly is silently overwritten. Boot
+ * 13 proved that -- every aes/sha result was a no-op and all FIPS KATs failed.
+ * Read and write context->ns.ns_64.v.q[] instead.
+ */
+
+static uint8_t sweet_aes_sbox[256];
+static uint8_t sweet_aes_inv_sbox[256];
+static uint8_t sweet_aes_tables_ready;
+
+static uint8_t
+sweet_aes_rotl8(uint8_t x, unsigned n)
+{
+	return (uint8_t)((uint8_t)(x << n) | (uint8_t)(x >> (8 - n)));
+}
+
+static uint8_t
+sweet_aes_xtime(uint8_t x)
+{
+	return (uint8_t)((uint8_t)(x << 1) ^ (uint8_t)((x & 0x80u) ? 0x1bu : 0x00u));
+}
+
+/* GF(2^8) multiply, reduction polynomial x^8 + x^4 + x^3 + x + 1 (0x11b) */
+static uint8_t
+sweet_aes_mul(uint8_t a, uint8_t b)
+{
+	uint8_t r = 0;
+
+	while (b != 0) {
+		if (b & 1u) {
+			r ^= a;
+		}
+		a = sweet_aes_xtime(a);
+		b = (uint8_t)(b >> 1);
+	}
+	return r;
+}
+
+/*
+ * The S-box is derived instead of tabulated: 256 bytes of literals are one
+ * transcription mistake away from a very confusing bug, and this runs once.
+ */
+static void
+sweet_aes_init_tables(void)
+{
+	unsigned i, y;
+
+	if (sweet_aes_tables_ready) {
+		return;
+	}
+	for (i = 0; i < 256; i++) {
+		uint8_t inv = 0;
+
+		if (i != 0) {
+			for (y = 1; y < 256; y++) {
+				if (sweet_aes_mul((uint8_t)i, (uint8_t)y) == 1u) {
+					inv = (uint8_t)y;
+					break;
+				}
+			}
+		}
+		sweet_aes_sbox[i] = (uint8_t)(inv ^ sweet_aes_rotl8(inv, 1) ^
+		    sweet_aes_rotl8(inv, 2) ^ sweet_aes_rotl8(inv, 3) ^
+		    sweet_aes_rotl8(inv, 4) ^ 0x63u);
+	}
+	for (i = 0; i < 256; i++) {
+		sweet_aes_inv_sbox[sweet_aes_sbox[i]] = (uint8_t)i;
+	}
+	sweet_aes_tables_ready = 1;
+}
+
+static void
+sweet_aes_shift_rows(uint8_t *s, boolean_t inverse)
+{
+	uint8_t t[16];
+	unsigned r, c;
+
+	for (r = 0; r < 16; r++) {
+		t[r] = s[r];
+	}
+	for (r = 0; r < 4; r++) {
+		for (c = 0; c < 4; c++) {
+			unsigned src = inverse ? ((c + 4u - r) & 3u) : ((c + r) & 3u);
+			s[r + 4u * c] = t[r + 4u * src];
+		}
+	}
+}
+
+static void
+sweet_aes_mix_columns(uint8_t *s, boolean_t inverse)
+{
+	unsigned c;
+
+	for (c = 0; c < 4; c++) {
+		uint8_t a0 = s[4u * c + 0], a1 = s[4u * c + 1];
+		uint8_t a2 = s[4u * c + 2], a3 = s[4u * c + 3];
+
+		if (!inverse) {
+			/*
+			 * Forward MixColumns without multiplications: with
+			 * t = a0^a1^a2^a3, each output byte is a_i ^ t ^ xtime(a_i ^ a_{i+1}).
+			 * Four xtime calls per column instead of four GF multiply loops.
+			 */
+			uint8_t t = (uint8_t)(a0 ^ a1 ^ a2 ^ a3);
+
+			s[4u * c + 0] = (uint8_t)(a0 ^ t ^ sweet_aes_xtime((uint8_t)(a0 ^ a1)));
+			s[4u * c + 1] = (uint8_t)(a1 ^ t ^ sweet_aes_xtime((uint8_t)(a1 ^ a2)));
+			s[4u * c + 2] = (uint8_t)(a2 ^ t ^ sweet_aes_xtime((uint8_t)(a2 ^ a3)));
+			s[4u * c + 3] = (uint8_t)(a3 ^ t ^ sweet_aes_xtime((uint8_t)(a3 ^ a0)));
+		} else {
+			/* Inverse path is not on the boot path yet: keep it obvious. */
+			s[4u * c + 0] = (uint8_t)(sweet_aes_mul(a0, 14) ^ sweet_aes_mul(a1, 11) ^
+			    sweet_aes_mul(a2, 13) ^ sweet_aes_mul(a3, 9));
+			s[4u * c + 1] = (uint8_t)(sweet_aes_mul(a0, 9) ^ sweet_aes_mul(a1, 14) ^
+			    sweet_aes_mul(a2, 11) ^ sweet_aes_mul(a3, 13));
+			s[4u * c + 2] = (uint8_t)(sweet_aes_mul(a0, 13) ^ sweet_aes_mul(a1, 9) ^
+			    sweet_aes_mul(a2, 14) ^ sweet_aes_mul(a3, 11));
+			s[4u * c + 3] = (uint8_t)(sweet_aes_mul(a0, 11) ^ sweet_aes_mul(a1, 13) ^
+			    sweet_aes_mul(a2, 9) ^ sweet_aes_mul(a3, 14));
+		}
+	}
+}
+
+/* vd/vn are separate registers: for aesmc/aesimc the result of Vn goes to Vd */
+static void
+sweet_aes_apply(uint8_t op, uint8_t *vd, const uint8_t *vn)
+{
+	unsigned i;
+
+	sweet_aes_init_tables();
+	switch (op) {
+	case SEO_AESE:
+		for (i = 0; i < 16; i++) {
+			vd[i] = (uint8_t)(vd[i] ^ vn[i]);
+		}
+		for (i = 0; i < 16; i++) {
+			vd[i] = sweet_aes_sbox[vd[i]];
+		}
+		sweet_aes_shift_rows(vd, FALSE);
+		break;
+	case SEO_AESD:
+		for (i = 0; i < 16; i++) {
+			vd[i] = (uint8_t)(vd[i] ^ vn[i]);
+		}
+		for (i = 0; i < 16; i++) {
+			vd[i] = sweet_aes_inv_sbox[vd[i]];
+		}
+		sweet_aes_shift_rows(vd, TRUE);
+		break;
+	case SEO_AESMC:
+	case SEO_AESIMC:
+		if (vd != vn) {
+			for (i = 0; i < 16; i++) {
+				vd[i] = vn[i];
+			}
+		}
+		sweet_aes_mix_columns(vd, op == SEO_AESIMC);
+		break;
+	default:
+		break;
+	}
+}
+
+/*
+ * --- SHA-1 / SHA-256 instructions ------------------------------------------
+ *
+ * Semantics ported from QEMU's target/arm/tcg/crypto_helper.c, which mirrors
+ * the Arm pseudocode. Words are little endian inside the 16-byte register, the
+ * layout every one of these instructions assumes.
+ */
+
+static uint32_t
+sweet_sha_rol(uint32_t x, unsigned n)
+{
+	return (uint32_t)((x << n) | (x >> (32 - n)));
+}
+
+static uint32_t
+sweet_sha_ror(uint32_t x, unsigned n)
+{
+	return (uint32_t)((x >> n) | (x << (32 - n)));
+}
+
+static uint32_t
+sweet_sha_ch(uint32_t x, uint32_t y, uint32_t z)
+{
+	return (uint32_t)((x & (y ^ z)) ^ z);
+}
+
+static uint32_t
+sweet_sha_par(uint32_t x, uint32_t y, uint32_t z)
+{
+	return (uint32_t)(x ^ y ^ z);
+}
+
+static uint32_t
+sweet_sha_maj(uint32_t x, uint32_t y, uint32_t z)
+{
+	return (uint32_t)((x & y) | ((x | y) & z));
+}
+
+static uint32_t
+sweet_sha_big_s0(uint32_t x)
+{
+	return (uint32_t)(sweet_sha_ror(x, 2) ^ sweet_sha_ror(x, 13) ^ sweet_sha_ror(x, 22));
+}
+
+static uint32_t
+sweet_sha_big_s1(uint32_t x)
+{
+	return (uint32_t)(sweet_sha_ror(x, 6) ^ sweet_sha_ror(x, 11) ^ sweet_sha_ror(x, 25));
+}
+
+static uint32_t
+sweet_sha_small_s0(uint32_t x)
+{
+	return (uint32_t)(sweet_sha_ror(x, 7) ^ sweet_sha_ror(x, 18) ^ (x >> 3));
+}
+
+static uint32_t
+sweet_sha_small_s1(uint32_t x)
+{
+	return (uint32_t)(sweet_sha_ror(x, 17) ^ sweet_sha_ror(x, 19) ^ (x >> 10));
+}
+
+static void
+sweet_sha_load(const uint8_t *p, uint32_t w[4])
+{
+	unsigned i;
+
+	for (i = 0; i < 4; i++) {
+		w[i] = (uint32_t)p[4 * i] | ((uint32_t)p[4 * i + 1] << 8) |
+		    ((uint32_t)p[4 * i + 2] << 16) | ((uint32_t)p[4 * i + 3] << 24);
+	}
+}
+
+static void
+sweet_sha_store(uint8_t *p, const uint32_t w[4])
+{
+	unsigned i;
+
+	for (i = 0; i < 4; i++) {
+		p[4 * i] = (uint8_t)w[i];
+		p[4 * i + 1] = (uint8_t)(w[i] >> 8);
+		p[4 * i + 2] = (uint8_t)(w[i] >> 16);
+		p[4 * i + 3] = (uint8_t)(w[i] >> 24);
+	}
+}
+
+static uint64_t
+sweet_sha_load64(const uint8_t *p)
+{
+	uint64_t v = 0;
+	unsigned i;
+
+	for (i = 0; i < 8; i++) {
+		v |= (uint64_t)p[i] << (8 * i);
+	}
+	return v;
+}
+
+static void
+sweet_sha_store64(uint8_t *p, uint64_t v)
+{
+	unsigned i;
+
+	for (i = 0; i < 8; i++) {
+		p[i] = (uint8_t)(v >> (8 * i));
+	}
+}
+
+/* sha1c / sha1p / sha1m: four rounds at once, the state kept b-rotated */
+static void
+sweet_sha1_rounds(uint8_t op, uint8_t *vd, const uint8_t *vn, const uint8_t *vm)
+{
+	uint32_t d[4], n[4], m[4];
+	unsigned i;
+
+	sweet_sha_load(vd, d);
+	sweet_sha_load(vn, n);
+	sweet_sha_load(vm, m);
+
+	for (i = 0; i < 4; i++) {
+		uint32_t f, t;
+
+		switch (op) {
+		case SEO_SHA1C:
+			f = sweet_sha_ch(d[1], d[2], d[3]);
+			break;
+		case SEO_SHA1P:
+			f = sweet_sha_par(d[1], d[2], d[3]);
+			break;
+		default:
+			f = sweet_sha_maj(d[1], d[2], d[3]);
+			break;
+		}
+		t = f + sweet_sha_rol(d[0], 5) + n[0] + m[i];
+		n[0] = d[3];
+		d[3] = d[2];
+		d[2] = sweet_sha_ror(d[1], 2);
+		d[1] = d[0];
+		d[0] = t;
+	}
+	sweet_sha_store(vd, d);
+}
+
+/* sha1su0 works on the two 64-bit halves, not on words */
+static void
+sweet_sha1su0(uint8_t *vd, const uint8_t *vn, const uint8_t *vm)
+{
+	uint64_t d0 = sweet_sha_load64(&vd[0]);
+	uint64_t d1 = sweet_sha_load64(&vd[8]);
+	uint64_t n0 = sweet_sha_load64(&vn[0]);
+	uint64_t m0 = sweet_sha_load64(&vm[0]);
+	uint64_t m1 = sweet_sha_load64(&vm[8]);
+
+	sweet_sha_store64(&vd[0], d1 ^ d0 ^ m0);
+	sweet_sha_store64(&vd[8], n0 ^ d1 ^ m1);
+}
+
+static void
+sweet_sha1h(uint8_t *vd, const uint8_t *vn)
+{
+	uint32_t n[4];
+
+	sweet_sha_load(vn, n);
+	n[0] = sweet_sha_ror(n[0], 2);
+	n[1] = 0;
+	n[2] = 0;
+	n[3] = 0;
+	sweet_sha_store(vd, n);
+}
+
+static void
+sweet_sha1su1(uint8_t *vd, const uint8_t *vn)
+{
+	uint32_t d[4], m[4];
+
+	sweet_sha_load(vd, d);
+	sweet_sha_load(vn, m);
+
+	d[0] = sweet_sha_rol(d[0] ^ m[1], 1);
+	d[1] = sweet_sha_rol(d[1] ^ m[2], 1);
+	d[2] = sweet_sha_rol(d[2] ^ m[3], 1);
+	d[3] = sweet_sha_rol(d[3] ^ d[0], 1);
+	sweet_sha_store(vd, d);
+}
+
+/* sha256h / sha256h2 share the round shape but differ in which half is fed */
+static void
+sweet_sha256_rounds(uint8_t op, uint8_t *vd, const uint8_t *vn, const uint8_t *vm)
+{
+	uint32_t d[4], n[4], m[4];
+	unsigned i;
+
+	sweet_sha_load(vd, d);
+	sweet_sha_load(vn, n);
+	sweet_sha_load(vm, m);
+
+	for (i = 0; i < 4; i++) {
+		uint32_t t;
+
+		if (op == SEO_SHA256H) {
+			t = sweet_sha_ch(n[0], n[1], n[2]) + n[3] +
+			    sweet_sha_big_s1(n[0]) + m[i];
+			n[3] = n[2];
+			n[2] = n[1];
+			n[1] = n[0];
+			n[0] = d[3] + t;
+
+			t += sweet_sha_maj(d[0], d[1], d[2]) + sweet_sha_big_s0(d[0]);
+			d[3] = d[2];
+			d[2] = d[1];
+			d[1] = d[0];
+			d[0] = t;
+		} else {
+			t = sweet_sha_ch(d[0], d[1], d[2]) + d[3] +
+			    sweet_sha_big_s1(d[0]) + m[i];
+			d[3] = d[2];
+			d[2] = d[1];
+			d[1] = d[0];
+			d[0] = n[3 - i] + t;
+		}
+	}
+	sweet_sha_store(vd, d);
+}
+
+static void
+sweet_sha256su0(uint8_t *vd, const uint8_t *vn)
+{
+	uint32_t d[4], m[4];
+
+	sweet_sha_load(vd, d);
+	sweet_sha_load(vn, m);
+
+	d[0] += sweet_sha_small_s0(d[1]);
+	d[1] += sweet_sha_small_s0(d[2]);
+	d[2] += sweet_sha_small_s0(d[3]);
+	d[3] += sweet_sha_small_s0(m[0]);
+	sweet_sha_store(vd, d);
+}
+
+static void
+sweet_sha256su1(uint8_t *vd, const uint8_t *vn, const uint8_t *vm)
+{
+	uint32_t d[4], n[4], m[4];
+
+	sweet_sha_load(vd, d);
+	sweet_sha_load(vn, n);
+	sweet_sha_load(vm, m);
+
+	d[0] += sweet_sha_small_s1(m[2]) + n[1];
+	d[1] += sweet_sha_small_s1(m[3]) + n[2];
+	d[2] += sweet_sha_small_s1(d[0]) + n[3];
+	d[3] += sweet_sha_small_s1(d[1]) + m[0];
+	sweet_sha_store(vd, d);
+}
+
+/*
+ * --- PMULL (GHASH) ---------------------------------------------------------
+ *
+ * pmull.1q multiplies two 64-bit polynomials into 128 bits; pmull2.1q does the
+ * same on the high halves. The 8h forms are eight independent 8x8 products and
+ * are not on the GCM path, but they are cheap to provide. Results are built in
+ * a local buffer so vd may alias vn/vm.
+ */
+
+static uint16_t
+sweet_clmul8(uint8_t a, uint8_t b)
+{
+	uint16_t r = 0;
+	unsigned i;
+
+	for (i = 0; i < 8; i++) {
+		if ((b >> i) & 1u) {
+			r ^= (uint16_t)a << i;
+		}
+	}
+	return r;
+}
+
+static void
+sweet_pmull64(uint64_t a, uint64_t b, uint8_t out[16])
+{
+	uint64_t lo = 0, hi = 0;
+	unsigned i;
+
+	for (i = 0; i < 64; i++) {
+		if ((b >> i) & 1u) {
+			lo ^= a << i;
+			if (i != 0) {
+				hi ^= a >> (64 - i);
+			}
+		}
+	}
+	sweet_sha_store64(&out[0], lo);
+	sweet_sha_store64(&out[8], hi);
+}
+
+static void
+sweet_pmull_q(uint8_t *vd, const uint8_t *vn, const uint8_t *vm, boolean_t high)
+{
+	unsigned off = high ? 8u : 0u;
+	uint8_t out[16];
+	unsigned i;
+
+	sweet_pmull64(sweet_sha_load64(&vn[off]), sweet_sha_load64(&vm[off]), out);
+	for (i = 0; i < 16; i++) {
+		vd[i] = out[i];
+	}
+}
+
+static void
+sweet_pmull_h(uint8_t *vd, const uint8_t *vn, const uint8_t *vm, boolean_t high)
+{
+	unsigned base = high ? 8u : 0u;
+	uint8_t out[16];
+	unsigned i;
+
+	for (i = 0; i < 8; i++) {
+		uint16_t r = sweet_clmul8(vn[base + i], vm[base + i]);
+
+		out[2 * i] = (uint8_t)r;
+		out[2 * i + 1] = (uint8_t)(r >> 8);
+	}
+	for (i = 0; i < 16; i++) {
+		vd[i] = out[i];
+	}
+}
+
+/* Returns TRUE when this exception has already been dealt with. */
+boolean_t
+sweet_crypto_emu_probe(arm_context_t *context, uint32_t instr)
+{
+	const struct sweet_crypto_encoding *enc;
+	boolean_t emulate;
+
+	if (sweet_emu_mode == 0) {
+		return FALSE;
+	}
+
+	enc = sweet_crypto_decode(instr);
+	if (enc == NULL) {
+		return FALSE;
+	}
+
+	/* AESE .. PMULL2_H are the opcodes we can now emulate for real */
+	emulate = (sweet_emu_mode >= 3) && (enc->op >= SEO_AESE) &&
+	    (enc->op <= SEO_PMULL2_H);
+
+	sweet_emu_hits[enc->op]++;
+	if (sweet_emu_printed[enc->op] < 3) {
+		sweet_emu_printed[enc->op]++;
+		printf("SWEET EMU %s/%s pc=%p vd=%u vn=%u vm=%d hits=%u mode=%u\n",
+		    enc->name,
+		    emulate ? "emul" : "skip",
+		    (void *)get_saved_state_pc(&context->ss),
+		    (unsigned)(instr & 0x1fu),
+		    (unsigned)((instr >> 5) & 0x1fu),
+		    (enc->nreg == 3) ? (int)((instr >> 16) & 0x1fu) : -1,
+		    (unsigned)sweet_emu_hits[enc->op],
+		    (unsigned)sweet_emu_mode);
+	}
+
+	if (sweet_emu_mode < 2) {
+		return FALSE;
+	}
+
+	if (emulate) {
+		arm_neon_saved_state64_t *ns;
+		unsigned vd = instr & 0x1fu;
+		unsigned vn = (instr >> 5) & 0x1fu;
+		unsigned vm = (instr >> 16) & 0x1fu;
+		uint8_t *d, *n, *m;
+
+		if (!is_neon_saved_state64(&context->ns)) {
+			return FALSE;
+		}
+		ns = neon_state64(&context->ns);
+		d = (uint8_t *)&ns->v.q[vd];
+		n = (uint8_t *)&ns->v.q[vn];
+		m = (uint8_t *)&ns->v.q[vm];
+
+		switch (enc->op) {
+		case SEO_AESE:
+		case SEO_AESD:
+		case SEO_AESMC:
+		case SEO_AESIMC:
+			sweet_aes_apply(enc->op, d, n);
+			break;
+		case SEO_SHA1C:
+		case SEO_SHA1P:
+		case SEO_SHA1M:
+			sweet_sha1_rounds(enc->op, d, n, m);
+			break;
+		case SEO_SHA1SU0:
+			sweet_sha1su0(d, n, m);
+			break;
+		case SEO_SHA1H:
+			sweet_sha1h(d, n);
+			break;
+		case SEO_SHA1SU1:
+			sweet_sha1su1(d, n);
+			break;
+		case SEO_SHA256H:
+		case SEO_SHA256H2:
+			sweet_sha256_rounds(enc->op, d, n, m);
+			break;
+		case SEO_SHA256SU0:
+			sweet_sha256su0(d, n);
+			break;
+		case SEO_SHA256SU1:
+			sweet_sha256su1(d, n, m);
+			break;
+		case SEO_PMULL_Q:
+			sweet_pmull_q(d, n, m, FALSE);
+			break;
+		case SEO_PMULL2_Q:
+			sweet_pmull_q(d, n, m, TRUE);
+			break;
+		case SEO_PMULL_H:
+			sweet_pmull_h(d, n, m, FALSE);
+			break;
+		case SEO_PMULL2_H:
+			sweet_pmull_h(d, n, m, TRUE);
+			break;
+		default:
+			break;
+		}
+	}
+
+	add_saved_state_pc(&context->ss, 4u);
+	return TRUE;
+}
