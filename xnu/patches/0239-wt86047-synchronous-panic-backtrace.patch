diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
--- a/osfmk/arm64/sleh.c
+++ b/osfmk/arm64/sleh.c
@@ -502,6 +502,33 @@
 	    state->pc, state->cpsr, state->esr, state->far);
 }
 
+#if defined(WT86047)
+/*
+ * Panic-safe string building. kprintf (printf) takes locks and reads per-CPU
+ * state, and calling it here made the first abort recurse inside the handler:
+ * the board double faulted and the watchdog reset it instead of halting with
+ * the dump on screen.
+ */
+static char *
+sleh_bt_str(char *p, const char *s)
+{
+	while (*s != 0) {
+		*p++ = *s++;
+	}
+	return p;
+}
+
+static char *
+sleh_bt_hex(char *p, uint64_t v)
+{
+	const char *d = "0123456789abcdef";
+
+	for (int sh = 60; sh >= 0; sh -= 4) {
+		*p++ = d[(v >> sh) & 0xf];
+	}
+	return p;
+}
+#endif
 void
 sleh_synchronous_sp1(arm_context_t *context, uint32_t esr, vm_offset_t far __unused)
 {
@@ -518,6 +545,55 @@
 	}
 		OS_FALLTHROUGH; // panic if we return from the debugger
 	default:
+#if defined(WT86047)
+	/*
+	 * The early console's panic path prints the reason and the register file
+	 * and then halts, so xnu never reaches its own backtrace printer.
+	 *
+	 * Read only the current stack: sp .. sp+384 is mapped by definition, so
+	 * nothing here can fault and turn the halt into a double fault. Report the
+	 * candidates in the fixed band at the bottom of the screen -- the log window
+	 * is 18 rows and the dump that follows fills 15 of them, so an ordinary
+	 * print here is scrolled away before it can be read.
+	 */
+	{
+		extern void sweet_early_fixed(int line, const char *s);
+		char bt_buf[96];
+		char *bt_p;
+		unsigned int bt_n = 0;
+		uint64_t bt_sp = get_saved_state_sp(state);
+		uint64_t bt_pc = get_saved_state_pc(state);
+
+		bt_p = bt_buf;
+		bt_p = sleh_bt_str(bt_p, "BT pc=");
+		bt_p = sleh_bt_hex(bt_p, bt_pc);
+		bt_p = sleh_bt_str(bt_p, " sp=");
+		bt_p = sleh_bt_hex(bt_p, bt_sp);
+		*bt_p = 0;
+		sweet_early_fixed(0, bt_buf);
+
+		bt_p = bt_buf;
+		for (unsigned int bt_i = 0; bt_i < 48 && bt_n < 5; bt_i++) {
+			uint64_t bt_v;
+
+			if (bt_sp < 0xfffffff000000000ULL || (bt_sp & 7) != 0) {
+				break;
+			}
+			bt_v = *(volatile uint64_t *)(bt_sp + bt_i * 8);
+			if (bt_v < 0xfffffff007004000ULL ||
+			    bt_v >= 0xfffffff007b7c000ULL) {
+				continue;
+			}
+			bt_p = sleh_bt_hex(bt_p, bt_v);
+			*bt_p++ = ' ';
+			bt_n++;
+		}
+		if (bt_p != bt_buf) {
+			*bt_p = 0;
+			sweet_early_fixed(1, bt_buf);
+		}
+	}
+#endif
 		panic_with_thread_kernel_state("Synchronous exception taken while SP1 selected", state);
 	}
 }
