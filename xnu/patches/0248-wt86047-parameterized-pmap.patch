--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -65,7 +65,7 @@
 # -mcpu: -arch arm64 otherwise keeps clang's apple-m1 default and its LSE/RCpc features
 MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53
 # wt86047: Cortex-A53 is ARMv8.0 (no LSE atomics). Enforce -mcpu=cortex-a53 and -march=armv8-a+crypto
-MACHINE_FLAGS_ARM64_WT86047 = -DARM64_BOARD_CONFIG_WT86047 -DARM64_BOARD_CONFIG_SWEET -mcpu=cortex-a53 -march=armv8-a+crypto
+MACHINE_FLAGS_ARM64_WT86047 = -DARM64_BOARD_CONFIG_WT86047 -DARM64_BOARD_CONFIG_SWEET -mcpu=cortex-a53 -march=armv8-a+crypto -DARM_PARAMETERIZED_PMAP=1 -D__ARM_MIXED_PAGE_SIZE__=1
 
 
