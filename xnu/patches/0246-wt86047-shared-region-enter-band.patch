  */
+#if defined(ARM64_BOARD_CONFIG_WT86047)
+/* SWEET: 0240 exports this; it draws into the band that never scrolls. */
+extern void sweet_early_fixed(int line, const char *s);
+
+/*
+ * Format without snprintf: this file includes no printf-family header, and a
+ * build failure here costs a full CI round.
+ */
+static void
+wt86047_sr_band(int line, const char *tag, unsigned int v)
+{
+	char b[40];
+	unsigned int i = 0;
+	const char *hex = "0123456789abcdef";
+	int sh;
+
+	while (tag[i] != 0 && i < 16) {
+		b[i] = tag[i];
+		i++;
+	}
+	b[i++] = '=';
+	b[i++] = '0';
+	b[i++] = 'x';
+	for (sh = 28; sh >= 0; sh -= 4) {
+		b[i++] = hex[(v >> sh) & 0xf];
+	}
+	b[i] = 0;
+	sweet_early_fixed(line, b);
+}
+#endif /* ARM64_BOARD_CONFIG_WT86047 */
